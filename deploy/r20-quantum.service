[Unit]
Description=AstraQuant Standalone Backend
After=network-online.target
Wants=network-online.target

# ⚠️ `/opt/r20-quantum-trader` 与 `User=r20` 是**历史部署约定**（内部代号 R20），
#    与对外品牌 AstraQuant 无关；沿用是为了不打断已按此路径部署的实例。
#    新部署请把下面的路径/用户改成你自己的实际克隆目录。

[Service]
Type=simple
User=r20
Group=r20
Environment=HOME=/home/r20
Environment=PATH=/opt/r20-quantum-trader/.venv/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/opt/r20-quantum-trader
EnvironmentFile=/opt/r20-quantum-trader/.env
ExecStart=/usr/bin/env python3 -m uvicorn r20_backend.app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
