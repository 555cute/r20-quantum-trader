[Unit]
Description=R20 Quantum Trader Standalone Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/r20-quantum-trader
EnvironmentFile=/opt/r20-quantum-trader/.env
Environment=R20_GATEWAY_MODE=external
ExecStart=/usr/bin/env python3 -m uvicorn r20_backend.app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
