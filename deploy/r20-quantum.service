[Unit]
Description=R20 Quantum Trader Standalone Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=r20
Group=r20
Environment=HOME=/home/r20
Environment=PATH=/opt/r20-quantum-trader/.venv/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/opt/r20-quantum-trader
EnvironmentFile=/opt/r20-quantum-trader/.env
ExecStart=/usr/bin/env R20_GATEWAY_WORKER_ENABLED=0 python3 -m uvicorn r20_backend.app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
