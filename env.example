# ==============================================================================
# R20 QUANTUM TRADER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your own credentials.
# ==============================================================================

# LLM Reasoning Gateway Configuration (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gemini-3.7-flash-high
LLM_REASONING_EFFORT=high

# OKX dual-environment configuration. LIVE and DEMO API Keys must be created separately.
# All strategy, ledger, dashboard and manual-close private requests share R20_OKX_ENV.
# Demo requests automatically carry x-simulated-trading: 1. Safe default is demo.
R20_OKX_ENV=demo
OKX_LIVE_API_KEY=
OKX_LIVE_SECRET_KEY=
OKX_LIVE_PASSPHRASE=
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET_KEY=
OKX_DEMO_PASSPHRASE=
# Legacy migration keys (optional; the admin plane stores new secrets encrypted).
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_IS_SIMULATED=1

# Web Dashboard Port & Host
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# Gateway ownership: embedded (backend supervises one worker), external, or disabled.
# Keep embedded for local and Docker deployments. Use external only with the systemd gateway service.
R20_GATEWAY_MODE=embedded

# Deployment metadata. Docker Compose overrides these values automatically.
R20_DEPLOYMENT_MODE=local
R20_BUILD_REVISION=dev

# Administrator protection for /admin. Generate a random setup token before first launch.
# After first login, set a permanent admin token in the admin page.
R20_SETUP_TOKEN=replace_with_a_long_random_setup_token
R20_ADMIN_TOKEN=
R20_MANUAL_CLOSE_ENABLED=0

# Notification fan-out. Each channel is independently enabled and can be tested from /admin.
R20_NOTIFY_WEBHOOK_ENABLED=0
R20_NOTIFICATION_WEBHOOK=
R20_NOTIFY_WECHAT_ENABLED=0
R20_WECHAT_WEBHOOK=
R20_NOTIFY_TELEGRAM_ENABLED=0
R20_TELEGRAM_BOT_TOKEN=
R20_TELEGRAM_CHAT_ID=
# Native QQ official application Bot. R20 obtains its own token and calls QQ Bot API directly.
R20_NOTIFY_QQ_ENABLED=0
R20_QQ_APP_ID=
R20_QQ_CLIENT_SECRET=
R20_QQ_OPENID=

# Backup targets are configured from /admin. Jobs keep only credential_ref;
# S3/OSS/WebDAV/Baidu OAuth secrets are encrypted in data/r20_backup_secrets.enc.
# Supported: local, Baidu official OAuth or ByPy, S3-compatible, Aliyun OSS,
# WebDAV/OpenList, Aliyun Drive bridge, and experimental Quark bridge.
R20_BACKUP_ENCRYPTION_KEY=
